{
  "name": "ord",
  "displayName": "ORD",
  "description": "Language support for the ORD language",
  "version": "0.1.0",
  "publisher": "tub-msc",
  "icon": "ordec.png",
  "license": "Apache-2.0 AND MIT",
  "spdx": [
    "SPDX-FileCopyrightText: 2026 ORDeC contributors",
    "SPDX-License-Identifier: Apache-2.0"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tub-msc/ordec.git",
    "directory": "support/editors/vscode/ord"
  },
  "engines": {
    "vscode": "^1.106.1"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:ord"
  ],
  "scripts": {
    "check": "node --check extension.js && node --test extension.test.js"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "ord",
    "ordec",
    "hdl",
    "ic design",
    "schematic"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "ord",
        "aliases": [
          "ORD",
          "ord"
        ],
        "extensions": [
          ".ord"
        ],
        "icon": {
          "light": "./icons/ord.svg",
          "dark": "./icons/ord.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ord",
        "scopeName": "source.ord",
        "path": "./syntaxes/ord.tmLanguage.json"
      },
      {
        "scopeName": "source.ord.injection",
        "path": "./syntaxes/ord-injection.tmLanguage.json",
        "injectTo": ["source.ord"]
      }
    ],
    "configuration": {
      "title": "ORD",
      "properties": {
        "ord.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Start ORD-LSP for ORD files."
        },
        "ord.languageServer.command": {
          "type": "string",
          "default": "ordec-lsp",
          "scope": "machine-overridable",
          "description": "ORD-LSP executable name or absolute path."
        },
        "ord.languageServer.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "description": "Arguments passed to the ORD-LSP executable."
        }
      }
    }
  }
}
