from ordec.core import *
from ordec.lib.ihp130 import SG13G2, Nmos

# A differential pair: two transistor branches amplifying the difference
# between inp and inn. Each branch is one schematic device with multiplier
# m=2, laid out as two parallel unit transistors interdigitated in the row
# m1a m2a m2b m1b (A B B A). Symbol and schematic are complete.
cell DiffPair:
    viewgen symbol -> Symbol:
        input inp: .align=West
        input inn: .align=West
        output outp: .align=East
        output outn: .align=East
        inout tail: .align=South
        inout vss: .align=South

    viewgen schematic -> Schematic:
        .outline = (0, 0, 22, 18)
        port inp: .align=East; .pos=(1,8)
        port inn: .align=East; .pos=(13,8)
        port outp: .align=West; .pos=(21,16)
        port outn: .align=East; .pos=(1,16)
        port tail: .align=East; .pos=(9,1)
        port vss: .align=West; .pos=(21,8)

        Nmos(w=1u, l=130n, m=2) m1: .pos=(3,6); .g -- inp; .d -- outn; .s -- tail; .b -- vss
        Nmos(w=1u, l=130n, m=2) m2: .pos=(15,6); .g -- inn; .d -- outp; .s -- tail; .b -- vss

    viewgen layout -> Layout:
        .ref_layers = SG13G2().layers
        layers = .ref_layers
        unit = Nmos(w=1u, l=130n)

        # EDIT HERE (row)

        # EDIT HERE (gates)
