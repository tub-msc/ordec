import math
from ordec.core import *
from ordec.lib import Res, Ind, Cap, Gnd, Vdc

cell Bandstop:
    # EDIT HERE (parameter)

    viewgen symbol -> Symbol:
        input vin: .align=West
        output vout: .align=East
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port vin: .align=East; .pos=(2,18)
        port vout: .align=West; .pos=(14,18)
        port vss: .align=North; .pos=(10,4)

        net mid

        Res r1: .$r=1k; .pos=(8,16); .orientation=R90; .p -- vin; .m -- vout
        Ind l1:
            .$l=10m # EDIT HERE (parameter calculation)
            .m -- mid
            .p -- vout
            .pos=(8,11)
        Cap c1: .$c=10n; .p -- mid; .pos=(8,6); .m -- vss


cell BandstopTb:
    viewgen schematic -> Schematic:
        net vin, vout, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vsrc: .$ac_mag=1; .m -- vss; .p -- vin; .pos=(0,6)
        vout % SchemTapPoint(pos=(18,11), align=East)

        # EDIT HERE (testbench)
        Bandstop f0:
            .pos=(6,9)
            .vin -- vin
            .vout -- vout
            .vss -- vss

    viewgen sim_ac -> Simulation:
        .simulate().ac('dec', 50, 100, 10M)

    viewgen bode -> Report:
        if (self.schematic.has_errors()
                or Bandstop().schematic.has_errors()
                or self.sim_ac.vout.voltage is None):
            .markdown("The Bode plot will show up here.")
        else:
            .bode_plot(self.sim_ac.vout, ref=self.sim_ac.vin)
