from ordec.core import *
from ordec.lib import Res, Ind, Cap, Gnd, Vdc

cell Bandstop:
    viewgen symbol -> Symbol:
        pass  # EDIT HERE (symbol)

    viewgen schematic -> Schematic:
        net mid

        Res r1: .$r=1k; .pos=(8,16); .orientation=R90
        Ind l1: .$l=1m; .n -- mid; .pos=(8,11)
        Cap c1: .$c=100n; .p -- mid; .pos=(8,6)

        # EDIT HERE (schematic)

cell BandstopTb:
    viewgen schematic -> Schematic:
        net vin, vout, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vsrc: .$ac_mag=1; .n -- vss; .p -- vin; .pos=(0,6)
        vout % SchemTapPoint(pos=(12,11), align=East)

        # EDIT HERE (testbench)

    viewgen sim_ac -> Simulation:
        .simulate().ac('dec', 500, 100, 10M)

    viewgen bode -> Report:
        if (self.schematic.has_errors()
                or Bandstop().schematic.has_errors()
                or self.sim_ac.vout.voltage is None):
            .markdown("The Bode plot will show up here.")
        else:
            .bode_plot(self.sim_ac.vout, ref=self.sim_ac.vin)
