from ordec.core import *
from ordec.lib import Res, Gnd, Vdc

cell RNetworkLoops:
    viewgen schematic -> Schematic:
        net vdd, vss, mid

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vsrc: .$dc=5; .m -- vss; .p -- vdd; .pos=(0,6)

        Res r1: .$r=1k; .pos=(9,16); .orientation=R180
        Res r2: .$r=2k; .pos=(5,6)
        Res r3: .$r=3k; .pos=(10,6)

        # EDIT HERE

    viewgen sim_op -> Simulation:
        .simulate().op()
