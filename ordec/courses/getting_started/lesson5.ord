from ordec.core import *
from ordec.lib import Res, Gnd, Vdc

cell RNetworkLoops:
    viewgen schematic -> Schematic:
        net vdd, vss, mid

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vsrc: .$dc=5; .m -- vss; .p -- vdd; .pos=(0,9)

        Res R0: .$r=2k; .pos=(5,6)
        Res R1: .$r=3k; .pos=(11,6)
        Res R2: .$r=1k; .pos=(12,16); .orientation=R180

        # EDIT HERE

    viewgen sim_op -> Simulation:
        .simulate().op()
