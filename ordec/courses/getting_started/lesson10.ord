from ordec.core import *
from ordec.lib import Res, Cap, Gnd, Vpulse

cell RcChain:
    viewgen schematic -> Schematic:
        net vin, mid, vout, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vpulse vsrc:
            .$initial_value=0
            .$pulsed_value=1
            .$rise_time=1u
            .$fall_time=1u
            .$pulse_width=1m
            .$period=2m
            .m -- vss
            .p -- vin
            .pos=(0,6)

        Res r1: .$r=1k; .p -- vin; .m -- mid; .pos=(8,12); .orientation=R90
        Cap c1: .$c=100n; .p -- mid; .m -- vss; .pos=(7,6)
        Res r2: .$r=1k; .p -- mid; .m -- vout; .pos=(14,12); .orientation=R90
        Cap c2: .$c=100n; .p -- vout; .m -- vss; .pos=(13,6)

        vout % SchemTapPoint(pos=(17, 14), align=East)

    viewgen sim_tran -> Simulation:
        .simulate().tran('1u', '4m')

    viewgen report -> Report:
        sim = self.sim_tran
        # EDIT HERE (postprocessing)
