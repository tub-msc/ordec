from ordec.core import *
from ordec.lib import Vdc, Res, Gnd, NoConn
from ordec.lib.ihp130 import Nmos

cell CsAmp:
    viewgen symbol -> Symbol:
        input vin: .align=West
        output vout: .align=East
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port vin: .align=East; .pos=(1,5)
        port vout: .align=West; .pos=(13,8)
        port vdd: .align=East; .pos=(1,14)
        port vss: .align=East; .pos=(1,2)

        Res rl: .$r=10k; .p -- vdd; .m -- vout; .pos=(6,9)

        # EDIT HERE

cell CsAmpTb:
    viewgen schematic -> Schematic:
        net vin, vout, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(0,6)
        Vdc vin_src: .$dc=0.45; .$ac_mag=1; .m -- vss; .p -- vin; .pos=(6,6)

        CsAmp dut: .vin -- vin; .vout -- vout; .vdd -- vdd; .vss -- vss; .pos=(12,6)
        NoConn nc: .a -- vout; .pos=(18,6)

    viewgen sim_dc -> Simulation:
        .simulate().dc_sweep(self.schematic.vin_src, 0, 1.2, 61)

    viewgen sim_ac -> Simulation:
        .simulate().ac('dec', 10, '1k', '1G')
