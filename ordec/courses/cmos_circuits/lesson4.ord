from ordec.core import *
from ordec.lib import Vdc, Res, Gnd, NoConn
from ordec.lib.ihp130 import Nmos

cell DiffPair:
    viewgen symbol -> Symbol:
        input inp: .align=West
        input inn: .align=West
        input bias: .align=West
        output outp: .align=East
        output outn: .align=East
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port inp: .align=East; .pos=(1,9)
        port inn: .align=West; .pos=(19,9)
        port bias: .align=East; .pos=(1,2)
        port outp: .align=East; .pos=(1,13)
        port outn: .align=West; .pos=(19,13)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,-1)

        net tail

        Res rl_p: .$r=30k; .p -- vdd; .m -- outp; .pos=(4,14)
        Res rl_n: .$r=30k; .p -- vdd; .m -- outn; .pos=(12,14)
        Nmos mtail: .$w=3u; .$l=1u; .g -- bias; .d -- tail; .s -- vss; .b -- vss; .pos=(8,0)

        # EDIT HERE

cell DiffPairTb:
    viewgen schematic -> Schematic:
        net inp, inn, bias, outp, outn, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(0,6)
        Vdc vinp_src: .$dc=0.7; .m -- vss; .p -- inp; .pos=(6,6)
        Vdc vinn_src: .$dc=0.7; .m -- vss; .p -- inn; .pos=(12,6)
        Vdc vbias_src: .$dc=0.5; .m -- vss; .p -- bias; .pos=(18,6)

        DiffPair dut: .inp -- inp; .inn -- inn; .bias -- bias; .outp -- outp; .outn -- outn; .vdd -- vdd; .vss -- vss; .pos=(24,12)
        NoConn nc0: .a -- outp; .pos=(32,10)
        NoConn nc1: .a -- outn; .pos=(32,16)

    viewgen sim_dc -> Simulation:
        .simulate().dc_sweep(self.schematic.vinp_src, 0.4, 1.0, 121)

    viewgen report_dc -> Report:
        sim = self.sim_dc
        .markdown("Differential pair transfer curve:")
        .plot2d(
            x=list(sim.inp.voltage),
            series={"outp": list(sim.outp.voltage), "outn": list(sim.outn.voltage)},
            xlabel="Vinp (V), Vinn = 0.7 V",
            ylabel="Vout (V)",
            height=300)
