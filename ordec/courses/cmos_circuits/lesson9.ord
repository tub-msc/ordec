from ordec.core import *
from ordec.lib import Vdc, Res, Gnd
from ordec.extlibrary import ExtLibrary
from ordec.lib import ihp130
from ordec.lib.ihp130 import Nmos, Pmos

stdcell_root = ihp130.pdk().root / "libs.ref/sg13g2_stdcell"
extlib = ExtLibrary()
extlib.read_lef(stdcell_root / "lef/sg13g2_stdcell.lef")
extlib.read_gds(stdcell_root / "gds/sg13g2_stdcell.gds", ihp130.SG13G2().layers)
extlib.read_spice(stdcell_root / "spice/sg13g2_stdcell.spice", device_map=ihp130.device_map)

cell Nor2:
    viewgen symbol -> Symbol:
        output y: .align=East
        input a: .align=West
        input b: .align=West
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port y: .align=West; .pos=(17,13)
        port a: .align=East; .pos=(1,10)
        port b: .align=East; .pos=(1,21)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,0)

        # EDIT HERE

cell Nor2Tb:
    viewgen schematic -> Schematic:
        net a, b, y, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(0,6)
        Vdc va_src: .$dc=0; .m -- vss; .p -- a; .pos=(6,6)
        Vdc vb_src: .$dc=0; .m -- vss; .p -- b; .pos=(12,6)

        Nor2 dut: .a -- a; .b -- b; .y -- y; .vdd -- vdd; .vss -- vss; .pos=(18,6)
        Res rprobe: .$r=1G; .p -- y; .m -- vss; .pos=(24,5)

    viewgen sim_op -> Simulation:
        .simulate().op()
