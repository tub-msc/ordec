from ordec.core import *
from ordec.lib import Vdc, Res, Cap, Gnd
from ordec.lib.ihp130 import Nmos, Pmos

cell InvAmp:
    viewgen symbol -> Symbol:
        input a: .align=West
        output y: .align=East
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port a: .align=East; .pos=(1,7)
        port y: .align=West; .pos=(15,7)
        port vdd: .align=East; .pos=(1,14)
        port vss: .align=East; .pos=(1,1)

        Nmos pd: .$w=1u; .$l=130n; .g -- a; .d -- y; .s -- vss; .b -- vss; .pos=(5,2)
        Pmos pu: .$w=2u; .$l=130n; .g -- a; .d -- y; .s -- vdd; .b -- vdd; .pos=(5,8)

        Res rf: .$r=100; .p -- a; .m -- y; .pos=(11,10) # EDIT HERE

cell InvAmpTb:
    viewgen schematic -> Schematic:
        net vin, ain, yout, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(0,6)
        Vdc vin_src: .$ac_mag=1; .m -- vss; .p -- vin; .pos=(6,6)
        Cap cc: .$c=10p; .p -- vin; .m -- ain; .pos=(12,6)

        InvAmp dut: .a -- ain; .y -- yout; .vdd -- vdd; .vss -- vss; .pos=(18,6)
        Cap cl: .$c=100f; .p -- yout; .m -- vss; .pos=(24,5)

    viewgen sim_op -> Simulation:
        .simulate().op()

    viewgen sim_ac -> Simulation:
        .simulate().ac('dec', 10, '1k', '10G')
