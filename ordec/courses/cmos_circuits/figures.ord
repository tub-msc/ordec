# Target circuits for the figure lessons (1, 3, 4, 6, 7, 9) of the
# cmos_circuits course. checks.target_figure() renders these schematics into
# the lesson reports, so everything in this file is shown to the student.
# The sizing puzzles (2, 8), the wiring bug hunt (5) and the capstone (10)
# deliberately have no figure; their solutions live only in the test suite.

from ordec.core import *
from ordec.lib import Vdc, Res, Gnd
from ordec.lib.ihp130 import Nmos, Pmos

cell MosCurves:
    vgs = Parameter(R, default=600m)

    viewgen schematic -> Schematic:
        net vss, vdd, gate, dn, dp

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(18,6)
        Vdc vg_src: .$dc=self.vgs; .m -- vss; .p -- gate; .pos=(0,6)
        Vdc vdn_src: .$dc=1.2; .m -- vss; .p -- dn; .pos=(6,6)
        Vdc vdp_src: .$dc=0; .m -- vss; .p -- dp; .pos=(12,6)

        Nmos mn: .$w=1u; .$l=130n; .g -- gate; .d -- dn; .s -- vss; .b -- vss; .pos=(22,12)
        Pmos mp: .$w=1u; .$l=130n; .g -- gate; .d -- dp; .s -- vdd; .b -- vdd; .pos=(30,12)

cell CsAmp:
    viewgen symbol -> Symbol:
        input vin: .align=West
        output vout: .align=East
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port vin: .align=East; .pos=(1,5)
        port vout: .align=West; .pos=(13,9)
        port vdd: .align=East; .pos=(1,13)
        port vss: .align=East; .pos=(1,1)

        Res rl: .$r=10k; .p -- vdd; .m -- vout; .pos=(6,9)
        Nmos m0: .$w=10u; .$l=130n; .g -- vin; .d -- vout; .s -- vss; .b -- vss; .pos=(6,3)

cell DiffPair:
    viewgen symbol -> Symbol:
        input inp: .align=West
        input inn: .align=West
        input bias: .align=West
        output outp: .align=East
        output outn: .align=East
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port inp: .align=East; .pos=(1,9)
        port inn: .align=West; .pos=(19,9)
        port bias: .align=East; .pos=(1,3)
        port outp: .align=East; .pos=(1,12)
        port outn: .align=West; .pos=(19,12)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,0)

        net tail

        Res rl_p: .$r=30k; .p -- vdd; .m -- outp; .pos=(4,13)
        Res rl_n: .$r=30k; .p -- vdd; .m -- outn; .pos=(10,13)
        Nmos mtail: .$w=3u; .$l=1u; .g -- bias; .d -- tail; .s -- vss; .b -- vss; .pos=(8,1)
        Nmos m1: .$w=5u; .$l=130n; .g -- inp; .d -- outp; .s -- tail; .b -- vss; .pos=(4,7)
        Nmos m2: .$w=5u; .$l=130n; .g -- inn; .d -- outn; .s -- tail; .b -- vss; .pos=(14,7); .orientation=FlippedSouth

cell Inv:
    viewgen symbol -> Symbol:
        inout vdd: .pos=(2, 4); .align=North
        inout vss: .pos=(2, 0); .align=South
        input a: .pos=(0, 2); .align=West
        output y: .pos=(4, 2); .align=East

        . % SymbolPoly(vertices=[(0, 2), (1, 2)])
        . % SymbolPoly(vertices=[(3.25, 2), (4, 2)])
        . % SymbolPoly(vertices=[(1, 1), (1, 3), (2.75, 2), (1, 1)])
        . % SymbolArc(pos=(3, 2), radius=R(0.25))

        .outline = Rect4R(lx=0, ly=0, ux=4, uy=4)

    viewgen schematic -> Schematic:
        .outline = Rect4R(lx=0, ly=0, ux=10, uy=14)

        port vdd: .pos=(2, 13); .align=East
        port vss: .pos=(2, 1); .align=East
        port a: .pos=(1, 7); .align=East
        port y: .pos=(9, 7); .align=West

        Nmos pd: .$w=1u; .$l=130n; .g -- a; .d -- y; .s -- vss; .b -- vss; .pos=(3,2)
        Pmos pu: .$w=2u; .$l=130n; .g -- a; .d -- y; .s -- vdd; .b -- vdd; .pos=(3,8)

cell Nand2:
    viewgen symbol -> Symbol:
        output y: .align=East
        input a: .align=West
        input b: .align=West
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port y: .align=West; .pos=(17,13)
        port a: .align=East; .pos=(1,10)
        port b: .align=East; .pos=(1,21)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,0)

        net x
        Nmos n1: .pos=(4,1); .s -- vss; .d -- x; .g -- a; .b -- vss
        Nmos n2: .pos=(4,7); .s -- x; .d -- y; .g -- b; .b -- vss
        Pmos p1: .pos=(4,13); .s -- vdd; .d -- y; .g -- a; .b -- vdd
        Pmos p2: .pos=(10,13); .s -- vdd; .d -- y; .g -- b; .b -- vdd

        for t in p1, p2, n1, n2:
            t.$w = 1u
            t.$l = 130n

cell Nor2:
    viewgen symbol -> Symbol:
        output y: .align=East
        input a: .align=West
        input b: .align=West
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port y: .align=West; .pos=(17,13)
        port a: .align=East; .pos=(1,10)
        port b: .align=East; .pos=(1,21)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,0)

        net x
        Nmos n1: .pos=(4,1); .$w=740n; .$l=130n; .s -- vss; .d -- y; .g -- a; .b -- vss
        Nmos n2: .pos=(10,1); .$w=740n; .$l=130n; .s -- vss; .d -- y; .g -- b; .b -- vss
        Pmos p1: .pos=(4,13); .$w=1.12u; .$l=130n; .s -- vdd; .d -- x; .g -- a; .b -- vdd
        Pmos p2: .pos=(4,7); .$w=1.12u; .$l=130n; .s -- x; .d -- y; .g -- b; .b -- vdd
