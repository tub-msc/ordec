from ordec.core import *
from ordec.lib import Vdc, Gnd
from ordec.lib.ihp130 import Nmos, Pmos

cell Nand2:
    viewgen symbol -> Symbol:
        output y: .align=East
        input a: .align=West
        input b: .align=West
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port y: .align=West; .pos=(18,12)
        port a: .align=East; .pos=(1,10)
        port b: .align=East; .pos=(1,21)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,0)

        # EDIT HERE
        Nmos n1: .pos=(4,1); .s -- vss; .d -- y; .g -- a; .b -- vss
        Pmos p1: .pos=(4,13); .s -- vdd; .d -- y; .g -- a; .b -- vdd

        for t in p1, n1:
            t.$w = 1u
            t.$l = 130n

cell Nand2Tb:
    viewgen schematic -> Schematic:
        net a, b, y, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(0,6)
        Vdc va_src: .$dc=1.2; .m -- vss; .p -- a; .pos=(6,6)
        Vdc vb_src: .$dc=1.2; .m -- vss; .p -- b; .pos=(12,6)

        Nand2 dut: .a -- a; .b -- b; .y -- y; .vdd -- vdd; .vss -- vss; .pos=(18,6)

    viewgen sim_op -> Simulation:
        .simulate().op()
