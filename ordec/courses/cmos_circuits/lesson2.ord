from ordec.core import *
from ordec.lib import Vdc, Idc, Gnd
from ordec.lib.ihp130 import Nmos

cell CurrentMirror:
    viewgen symbol -> Symbol:
        input iin
        output iout
        inout vss

    viewgen schematic -> Schematic:
        port iin: .pos=(0,8)
        port iout: .pos=(14,8)
        port vss: .align=East; .pos=(0,2)

        Nmos n0: .pos=(6,3); .orientation=FlippedSouth; .$w=1u; .$l=1u; .d -- iin; .g -- iin; .s -- vss; .b -- vss
        # EDIT HERE
        Nmos n1: .pos=(8,3); .$w=1u; .$l=1u; .d -- iout; .g -- iin; .s -- vss; .b -- vss

cell CurrentMirrorTb:
    viewgen schematic -> Schematic:
        net vss, vdd, iin, iout

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(0,6)
        Idc iref: .$dc=10u; .p -- vdd; .m -- iin; .pos=(6,6)
        Vdc vout_src: .$dc=0.6; .p -- vdd; .m -- iout; .pos=(18,6)

        CurrentMirror dut: .iin -- iin; .iout -- iout; .vss -- vss; .pos=(12,6)

    viewgen sim_op -> Simulation:
        .simulate().op(save_params=True)
