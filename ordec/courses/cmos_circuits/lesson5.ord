from ordec.core import *
from ordec.lib import Vdc, Res, Cap, Gnd, NoConn
from ordec.lib.ihp130 import Nmos

cell DiffPair:
    """The differential pair from the previous lesson, ready to use."""

    viewgen symbol -> Symbol:
        input inp: .align=West
        input inn: .align=West
        input bias: .align=West
        output outp: .align=East
        output outn: .align=East
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port inp: .align=East; .pos=(1,9)
        port inn: .align=West; .pos=(19,9)
        port bias: .align=East; .pos=(1,3)
        port outp: .align=East; .pos=(1,12)
        port outn: .align=West; .pos=(19,12)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,0)

        net tail

        Res rl_p: .$r=30k; .p -- vdd; .m -- outp; .pos=(4,13)
        Res rl_n: .$r=30k; .p -- vdd; .m -- outn; .pos=(10,13)
        Nmos mtail: .$w=3u; .$l=1u; .g -- bias; .d -- tail; .s -- vss; .b -- vss; .pos=(8,1)
        Nmos m1: .$w=5u; .$l=130n; .g -- inp; .d -- outp; .s -- tail; .b -- vss; .pos=(4,7)
        Nmos m2: .$w=5u; .$l=130n; .g -- inn; .d -- outn; .s -- tail; .b -- vss; .pos=(14,7); .orientation=FlippedSouth

cell RingOsc:
    viewgen symbol -> Symbol:
        input bias: .align=West
        output outp: .align=East
        output outn: .align=East
        inout vdd: .align=North
        inout vss: .align=South

    viewgen schematic -> Schematic:
        port bias: .align=East; .pos=(0,15)
        port outp: .align=West; .pos=(40,10)
        port outn: .align=West; .pos=(40,11)
        port vdd: .align=East; .pos=(0,18)
        port vss: .align=East; .pos=(0,0)

        net p1, n1, p2, n2

        Cap cp1: .$c=100f; .$ic=0.9; .p -- p1; .m -- vss; .pos=(9,1)
        Cap cn1: .$c=100f; .$ic=0.9; .p -- n1; .m -- vss; .pos=(14,1)
        Cap cp2: .$c=100f; .$ic=0.9; .p -- p2; .m -- vss; .pos=(23,1)
        Cap cn2: .$c=100f; .$ic=0.9; .p -- n2; .m -- vss; .pos=(28,1)
        Cap cp0: .$c=100f; .$ic=1.2; .p -- outp; .m -- vss; .pos=(37,1)
        Cap cn0: .$c=100f; .$ic=0.6; .p -- outn; .m -- vss; .pos=(42,1)

        DiffPair stage0: .inp -- outn; .inn -- outp; .outp -- p1; .outn -- n1; .bias -- bias; .vdd -- vdd; .vss -- vss; .pos=(4,8) # EDIT HERE
        DiffPair stage1: .inp -- p1; .inn -- n1; .outp -- p2; .outn -- n2; .bias -- bias; .vdd -- vdd; .vss -- vss; .pos=(18,8)
        DiffPair stage2: .inp -- p2; .inn -- n2; .outp -- outp; .outn -- outn; .bias -- bias; .vdd -- vdd; .vss -- vss; .pos=(32,8)

cell RingOscTb:
    viewgen schematic -> Schematic:
        net bias, outp, outn, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .m -- vss; .p -- vdd; .pos=(0,6)
        Vdc vbias_src: .$dc=0.5; .m -- vss; .p -- bias; .pos=(6,6)

        RingOsc dut: .bias -- bias; .outp -- outp; .outn -- outn; .vdd -- vdd; .vss -- vss; .pos=(12,6)
        NoConn nc0: .a -- outp; .pos=(18,6)
        NoConn nc1: .a -- outn; .pos=(18,12)

    viewgen sim_tran -> Simulation:
        .simulate().tran('50p', '200n', uic=True)

    viewgen report_tran -> Report:
        sim = self.sim_tran
        .markdown("Ring oscillator output:")
        .plot2d(
            x=list(sim.time),
            series={"outp": list(sim.outp.voltage), "outn": list(sim.outn.voltage)},
            xlabel="Time (s)",
            ylabel="Voltage (V)",
            height=300)
