from ordec.core import *
from ordec.lib import Vdc, Cap, Gnd
from ordec.lib.ihp130 import Nmos, Pmos, Rsil, Rppd, Rhigh, Cmim

cell Amp:
    viewgen symbol(self) -> Symbol:
        input vin
        output vout
        inout vdd: .align=North
        inout vss

    viewgen schematic(self) -> Schematic:
        port vin: .pos=(1,5)
        port vout: .pos=(19,8)
        port vdd: .align=East; .pos=(1,14)
        port vss: .align=East; .pos=(1,2)

        # EDIT HERE: your amplifier. Only ihp130 Nmos, Pmos, Rsil,
        # Rppd, Rhigh and Cmim are allowed (see the course panel).

# Fixed testbench: this is what your submission is scored against, at
# every process corner (the sim_* views here show the nominal one).
# Editing it only fools your own screen, not the final ranking.
cell AmpTb:
    viewgen schematic(self) -> Schematic:
        net vin, vout, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .n -- vss; .p -- vdd; .pos=(0,6)
        Vdc vin_src: .$dc=0.6; .$ac_mag=1; .n -- vss; .p -- vin; .pos=(6,6)

        Amp dut: .vin -- vin; .vout -- vout; .vdd -- vdd; .vss -- vss; .pos=(12,6)
        Cap cload: .$c=1p; .p -- vout; .n -- vss; .pos=(20,6)

    viewgen sim_op(self) -> Simulation:
        .simulate().op()

    viewgen sim_dc(self) -> Simulation:
        .simulate().dc_sweep(self.schematic.vin_src, 0, 1.2, 121)

    viewgen sim_ac(self) -> Simulation:
        .simulate().ac('dec', 10, 1k, 10G)

    viewgen report_dc(self) -> Report:
        sim = self.sim_dc
        .markdown("Transfer curve (input DC operating point is 0.6 V):")
        .plot2d(sim.vin.voltage, sim.vout,
            xlabel="Vin (V)", ylabel="Vout (V)")

    viewgen report_ac(self) -> Report:
        .markdown("Gain over frequency:")
        .bode_plot(self.sim_ac.vout)
