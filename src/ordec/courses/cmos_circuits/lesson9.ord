from ordec.core import *
from ordec.lib import Vdc, Res, Gnd
from ordec.extlibrary import ExtLibrary
from ordec.lib import ihp130

stdcell_root = ihp130.pdk().root / "libs.ref/sg13g2_stdcell"
extlib = ExtLibrary()
extlib.read_lef(stdcell_root / "lef/sg13g2_stdcell.lef")
extlib.read_gds(stdcell_root / "gds/sg13g2_stdcell.gds", ihp130.SG13G2().layers)
extlib.read_spice(stdcell_root / "spice/sg13g2_stdcell.spice", device_map=ihp130.device_map)

Xor2 = extlib['sg13g2_xor2_1']

cell Xor2Tb:
    a = Parameter(R, default=0)
    b = Parameter(R, default=0)

    viewgen schematic(self) -> Schematic:
        net a, b, y, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .n -- vss; .p -- vdd; .pos=(0,6)
        Vdc va_src: .$dc=self.a; .n -- vss; .p -- a; .pos=(6,6)
        Vdc vb_src: .$dc=self.b; .n -- vss; .p -- b; .pos=(12,6)

        # EDIT HERE

        Res rprobe: .$r=1G; .p -- y; .n -- vss; .pos=(28,9)

    viewgen sim_op(self) -> Simulation:
        .simulate().op()
