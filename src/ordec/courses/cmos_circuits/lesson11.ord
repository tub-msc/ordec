from ordec.core import *
from ordec.lib import Vdc, Res, Cap, Gnd
from ordec.lib.ihp130 import Nmos, Pmos

cell Ota:
    viewgen symbol(self) -> Symbol:
        input inp
        input inn
        input bias
        output out
        inout vdd: .align=North
        inout vss

    viewgen schematic(self) -> Schematic:
        port inp: .pos=(1,9)
        port inn: .align=West; .pos=(19,9)
        port bias: .pos=(1,2)
        port out: .pos=(19,13)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,-1)

        net tail, outx

        Nmos mtail: .$w=3u; .$l=1u; .g -- bias; .d -- tail; .s -- vss; .b -- vss; .pos=(8,0)

        # EDIT HERE
        Res rl_p: .$r=30k; .p -- vdd; .n -- outx; .pos=(4,14)
        Res rl_n: .$r=30k; .p -- vdd; .n -- out; .pos=(12,14)
        Nmos m1: .$w=5u; .$l=130n; .g -- inp; .d -- outx; .s -- tail; .b -- vss; .pos=(4,7)
        Nmos m2: .$w=5u; .$l=130n; .g -- inn; .d -- out; .s -- tail; .b -- vss; .pos=(16,7); .orientation=FlippedSouth

cell OtaTb:
    viewgen schematic(self) -> Schematic:
        net inp, inn, bias, out, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .n -- vss; .p -- vdd; .pos=(0,6)
        Vdc vinp_src: .$dc=0.7; .$ac_mag=1; .n -- vss; .p -- inp; .pos=(6,6)
        Vdc vinn_src: .$dc=0.7; .n -- vss; .p -- inn; .pos=(12,6)
        Vdc vbias_src: .$dc=0.5; .n -- vss; .p -- bias; .pos=(18,6)

        Ota dut: .inp -- inp; .inn -- inn; .bias -- bias; .out -- out; .vdd -- vdd; .vss -- vss; .pos=(24,12)
        Cap cl: .$c=1p; .p -- out; .n -- vss; .pos=(32,8)

    viewgen sim_dc(self) -> Simulation:
        .simulate().dc_sweep(self.schematic.vinp_src, 0.55, 0.85, 121)

    viewgen sim_op(self) -> Simulation:
        .simulate().op(save_params=True)

    viewgen sim_ac(self) -> Simulation:
        .simulate().ac('dec', 20, 100, 10G)

    viewgen report_dc(self) -> Report:
        sim = self.sim_dc
        .markdown("OTA transfer curve:")
        .plot2d(sim.inp.voltage,
            sim.out,
            xlabel="Vinp (V), Vinn = 0.7 V",
            ylabel="Vout (V)",
            height=300)
