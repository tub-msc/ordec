from ordec.core import *
from ordec.lib import Vdc, Res, Cap, Gnd, NoConn
from ordec.lib.ihp130 import Nmos

cell DiffPair:
    """The differential pair from the previous lesson, ready to use."""

    viewgen symbol(self) -> Symbol:
        input inp
        input inn
        input bias
        output outp
        output outn
        inout vdd: .align=North
        inout vss

    viewgen schematic(self) -> Schematic:
        port inp: .pos=(1,9)
        port inn: .align=West; .pos=(19,9)
        port bias: .pos=(1,2)
        port outp: .align=East; .pos=(1,13)
        port outn: .pos=(19,13)
        port vdd: .align=East; .pos=(1,19)
        port vss: .align=East; .pos=(1,-1)

        net tail

        Res rl_p: .$r=30k; .p -- vdd; .n -- outp; .pos=(4,14)
        Res rl_n: .$r=30k; .p -- vdd; .n -- outn; .pos=(12,14)
        Nmos mtail: .$w=3u; .$l=1u; .g -- bias; .d -- tail; .s -- vss; .b -- vss; .pos=(8,0)
        Nmos m1: .$w=5u; .$l=130n; .g -- inp; .d -- outp; .s -- tail; .b -- vss; .pos=(4,7)
        Nmos m2: .$w=5u; .$l=130n; .g -- inn; .d -- outn; .s -- tail; .b -- vss; .pos=(16,7); .orientation=FlippedSouth

cell RingOsc:
    viewgen symbol(self) -> Symbol:
        input bias
        output outp
        output outn
        inout vdd: .align=North
        inout vss

    viewgen schematic(self) -> Schematic:
        port bias: .pos=(0,15)
        port outp: .pos=(40,10)
        port outn: .pos=(40,11)
        port vdd: .align=East; .pos=(0,18)
        port vss: .align=East; .pos=(0,0)

        net p1, n1, p2, n2

        Cap cp1: .$c=100f; .$ic=0.9; .p -- p1; .n -- vss; .pos=(9,1)
        Cap cn1: .$c=100f; .$ic=0.9; .p -- n1; .n -- vss; .pos=(14,1)
        Cap cp2: .$c=100f; .$ic=0.9; .p -- p2; .n -- vss; .pos=(23,1)
        Cap cn2: .$c=100f; .$ic=0.9; .p -- n2; .n -- vss; .pos=(28,1)
        Cap cp0: .$c=100f; .$ic=1.2; .p -- outp; .n -- vss; .pos=(37,1)
        Cap cn0: .$c=100f; .$ic=0.6; .p -- outn; .n -- vss; .pos=(42,1)

        # EDIT HERE
        DiffPair stage0: .inp -- outn; .inn -- outp; .outp -- p1; .outn -- n1; .bias -- bias; .vdd -- vdd; .vss -- vss; .pos=(4,8)
        DiffPair stage1: .inp -- p1; .inn -- n1; .outp -- p2; .outn -- n2; .bias -- bias; .vdd -- vdd; .vss -- vss; .pos=(18,8)
        DiffPair stage2: .inp -- p2; .inn -- n2; .outp -- outp; .outn -- outn; .bias -- bias; .vdd -- vdd; .vss -- vss; .pos=(32,8)

cell RingOscTb:
    viewgen schematic(self) -> Schematic:
        net bias, outp, outn, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .n -- vss; .p -- vdd; .pos=(0,6)
        Vdc vbias_src: .$dc=0.5; .n -- vss; .p -- bias; .pos=(6,6)

        RingOsc dut: .bias -- bias; .outp -- outp; .outn -- outn; .vdd -- vdd; .vss -- vss; .pos=(12,6)
        NoConn nc0: .a -- outp; .pos=(18,6)
        NoConn nc1: .a -- outn; .pos=(18,12)

    viewgen sim_tran(self) -> Simulation:
        .simulate().tran(50p, 200n, uic=True)

    viewgen report_tran(self) -> Report:
        sim = self.sim_tran
        .markdown("Ring oscillator output:")
        .plot2d(
            x=list(sim.time),
            series={"outp": list(sim.outp.voltage), "outn": list(sim.outn.voltage)},
            xlabel="Time (s)",
            ylabel="Voltage (V)",
            height=300)
