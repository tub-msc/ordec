from ordec.core import *
from ordec.lib import Vdc, Gnd

# EDIT HERE (import)

cell MosCurves:
    vgs = Parameter(R, default=600m)

    viewgen schematic(self) -> Schematic:
        net vss, vdd, gate, drain_n, drain_p

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .n -- vss; .p -- vdd; .pos=(18,6)
        Vdc vg_src: .$dc=self.vgs; .n -- vss; .p -- gate; .pos=(7,6)
        Vdc vdn_src: .$dc=1.2; .n -- vss; .p -- drain_n; .pos=(0,6)
        Vdc vdp_src: .$dc=0; .n -- vss; .p -- drain_p; .pos=(25,6)

        # EDIT HERE (transistors)

    viewgen sim_vgs(self) -> Simulation:
        .simulate().dc_sweep(self.schematic.vg_src, 0, 1.2, 61, save_params=True)

    viewgen sim_vds(self) -> Simulation:
        .simulate().dc_sweep(self.schematic.vdn_src, 0, 1.2, 61, save_params=True)

    viewgen sim_vsd(self) -> Simulation:
        .simulate().dc_sweep(self.schematic.vdp_src, 0, 1.2, 61, save_params=True)

    viewgen report_curves(self) -> Report:
        try:
            self.schematic.mn
            self.schematic.mp
            placed = True
        except AttributeError:
            placed = False
        if not placed:
            .markdown("Place the transistors `mn` and `mp` first (see the "
                "EDIT HERE markers in the source).")
        else:
            .markdown("ID over VDS for several gate-source voltages.")
            vds_n = [float(v) for v in MosCurves(vgs=R('1.2')).sim_vds.drain_n.voltage]
            vds_p = [float(v) - 1.2 for v in MosCurves(vgs=R('0')).sim_vsd.drain_p.voltage]
            nmos_series = {}
            pmos_series = {}
            for vgs in ('0.6', '0.8', '1.0', '1.2'):
                sim_n = MosCurves(vgs=R(vgs)).sim_vds
                sim_p = MosCurves(vgs=R('1.2') - R(vgs)).sim_vsd
                nmos_series["VGS = " + vgs + " V"] = [
                    float(i) for i in sim_n.mn.params['ids'].value]
                pmos_series["VSG = " + vgs + " V"] = [
                    -float(i) for i in sim_p.mp.params['ids'].value]
            .plot2d(nmos_series,
                x=vds_n,
                xlabel="VDS (V)",
                ylabel="NMOS ID (A)",
                height=280)
            .plot2d(pmos_series,
                x=vds_p,
                xlabel="VDS (V)",
                ylabel="PMOS ID (A)",
                height=280)
