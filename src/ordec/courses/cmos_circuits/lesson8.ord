from ordec.core import *
from ordec.lib import Vdc, Gnd
from ordec.lib.ihp130 import Nmos, Pmos

cell Nand2:
    viewgen symbol(self) -> Symbol:
        output y
        input a
        input b
        inout vdd: .align=North
        inout vss

    viewgen schematic(self) -> Schematic:
        port y: .pos=(18,12)
        port a: .pos=(1,15)
        port b: .pos=(1,9)
        port vdd: .align=East; .pos=(1,18)
        port vss: .align=East; .pos=(1,0)

        # EDIT HERE
        Nmos n1: .pos=(4,1); .s -- vss; .d -- y; .g -- a; .b -- vss
        Pmos p1: .pos=(4,13); .s -- vdd; .d -- y; .g -- a; .b -- vdd

        for t in p1, n1:
            t.$w = 1u
            t.$l = 130n

cell Nand2Tb:
    viewgen schematic(self) -> Schematic:
        net a, b, y, vdd, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vdc vdd_src: .$dc=1.2; .n -- vss; .p -- vdd; .pos=(0,6)
        Vdc va_src: .$dc=1.2; .n -- vss; .p -- a; .pos=(6,6)
        Vdc vb_src: .$dc=1.2; .n -- vss; .p -- b; .pos=(12,6)

        Nand2 dut: .a -- a; .b -- b; .y -- y; .vdd -- vdd; .vss -- vss; .pos=(18,6)

    viewgen sim_op(self) -> Simulation:
        .simulate().op()
