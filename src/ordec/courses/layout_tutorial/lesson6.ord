from ordec.core import *
from ordec.lib.ihp130 import SG13G2, Nmos, Pmos, Ntap, Ptap

# The CMOS inverter we lay out in lessons 6 to 9. Symbol and schematic are
# already complete: an NMOS and a PMOS transistor between vss and vdd, the
# input a driving both gates, the output y at the connected drains.
cell Inv:
    viewgen symbol(self) -> Symbol:
        input a
        output y
        inout vdd: .align=North
        inout vss

    viewgen schematic(self) -> Schematic:
        port a: .pos=(1,7)
        port y: .pos=(9,7)
        port vdd: .align=East; .pos=(2,13)
        port vss: .align=East; .pos=(2,1)

        Nmos(w=1u, l=130n) mn: .pos=(3,2); .s -- vss; .b -- vss; .g -- a; .d -- y
        Pmos(w=1u, l=130n) mp: .pos=(3,8); .s -- vdd; .b -- vdd; .g -- a; .d -- y

    viewgen layout(self) -> Layout:
        .ref_layers = SG13G2().layers
        layers = .ref_layers

        # EDIT HERE (devices)
