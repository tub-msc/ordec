from ordec.core import *
from ordec.lib.ihp130 import SG13G2, Nmos, Ptap, run_drc, run_lvs
from ordec.layout import SRouter

cell DiffPair:
    viewgen symbol -> Symbol:
        input inp
        input inn
        output outp
        output outn
        inout tail
        inout vss

    viewgen schematic -> Schematic:
        port inp: .pos=(1,8)
        port inn: .align=West; .pos=(19,8)
        port outp: .pos=(19,13)
        port outn: .align=East; .pos=(1,13)
        port tail: .pos=(10,1)
        port vss: .pos=(10,7)

        Nmos(w=1u, l=130n, m=2) m1: .pos=(3,6); .g -- inp; .d -- outn; .s -- tail; .b -- vss
        Nmos(w=1u, l=130n, m=2) m2: .pos=(17,6); .g -- inn; .d -- outp; .s -- tail; .b -- vss; .orientation=FlippedSouth

    viewgen layout -> Layout:
        .ref_layers = SG13G2().layers
        layers = .ref_layers

        # The matched row from lesson 10:
        Nmos m1a, m2a, m2b, m1b
        for m in m1a, m2a, m2b, m1b:
            m.$w = 1u
            m.$l = 130n
        ! m1a.pos == (0, 0)
        ! m2a.sd[0].center == m1a.sd[1].center
        ! m2a.pos.y == m1a.pos.y
        ! m2b.sd[0].center == m2a.sd[1].center
        ! m2b.pos.y == m1a.pos.y
        ! m1b.sd[0].center == m2b.sd[1].center
        ! m1b.pos.y == m1a.pos.y

        # The inn gate comb and contact from lesson 10:
        LayoutRect inn_bar:
            .layer = layers.GatPoly
            ! .lx == m2a.poly[0].lx
            ! .ux == m2b.poly[0].ux
            ! .ly == m2a.poly[0].uy + 250
            ! .height == 130
        LayoutRect inn_drop_a:
            .layer = layers.GatPoly
            ! .x_extent == m2a.poly[0].x_extent
            ! .uy == inn_bar.uy
            ! .ly == m2a.poly[0].uy - 100
        LayoutRect inn_drop_b:
            .layer = layers.GatPoly
            ! .x_extent == m2b.poly[0].x_extent
            ! .uy == inn_bar.uy
            ! .ly == m2b.poly[0].uy - 100
        LayoutRect inn_ext:
            .layer = layers.GatPoly
            ! .size == (500, 500)
            ! .south == inn_bar.north
        LayoutRect inn_cont:
            .layer = layers.Cont
            ! .size == (160, 160)
            ! .center == inn_ext.center
        LayoutRect m1_inn:
            .layer = layers.Metal1
            ! .center == inn_cont.center
            ! .size == (500, 200)

        # The inp comb: the same pattern, mirrored downward for the two
        # outer gates, with its contact west of the row.
        LayoutRect inp_bar:
            .layer = layers.GatPoly
            ! .lx == m1a.poly[0].lx
            ! .ux == m1b.poly[0].ux
            ! .uy == m2a.poly[0].ly - 250
            ! .height == 130
        LayoutRect inp_drop_a:
            .layer = layers.GatPoly
            ! .x_extent == m1a.poly[0].x_extent
            ! .ly == inp_bar.ly
            ! .uy == m1a.poly[0].ly + 100
        LayoutRect inp_drop_b:
            .layer = layers.GatPoly
            ! .x_extent == m1b.poly[0].x_extent
            ! .ly == inp_bar.ly
            ! .uy == m1b.poly[0].ly + 100
        LayoutRect inp_ext:
            .layer = layers.GatPoly
            ! .size == (500, 500)
            ! .ux == inp_drop_a.lx
            ! .cy == inp_bar.cy
        LayoutRect inp_cont:
            .layer = layers.Cont
            ! .size == (160, 160)
            ! .center == inp_ext.center
        LayoutRect m1_inp:
            .layer = layers.Metal1
            ! .center == inp_cont.center
            ! .size == (500, 200)

        # Substrate tap and vss rail below the row:
        Ptap ptap:
            .$l = 0.7u
            .$w = 0.7u
            ! .activ.cx == 0.5*m1a.activ.lx + 0.5*m1b.activ.ux
            ! .activ.uy == m1a.pos.y - 1200
        LayoutRect m1_vss:
            .layer = layers.Metal1
            ! .height == 160
            ! .cy == ptap.m1.cy
            ! .lx == m1a.activ.lx - 400
            ! .ux == m1b.activ.ux + 400

        # EDIT HERE (route)

        # EDIT HERE (pins)

    @generate(auto_refresh=False)
    viewgen drc -> DrcReport:
        . = run_drc(self.layout, variant="minimal")

    @generate(auto_refresh=False)
    viewgen lvs -> LvsReport:
        . = run_lvs(self.layout, self.symbol)
