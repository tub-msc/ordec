from ordec.core import *
from ordec.lib import Res, Cap, Gnd, Vpulse

cell RcChain:
    viewgen schematic(self) -> Schematic:
        net vin, mid, vout, vss

        Gnd gnd: .p -- vss; .pos=(0,0)
        Vpulse vsrc:
            .$initial_value=0
            .$pulsed_value=1
            .$rise_time=5u
            .$fall_time=5u
            .$pulse_width=500u
            .$delay_time=250u
            .$period=1m
            .n -- vss
            .p -- vin
            .pos=(0,6)

        Res r1: .$r=1k; .p -- vin; .n -- mid; .pos=(8,12); .orientation=R90
        Cap c1: .$c=10n; .p -- mid; .n -- vss; .pos=(7,6)
        Res r2: .$r=5k; .p -- mid; .n -- vout; .pos=(14,12); .orientation=R90
        Cap c2: .$c=10n; .p -- vout; .n -- vss; .pos=(13,6)

        vout % SchemTapPoint(pos=(17, 14), align=East)

    # EDIT HERE (analysis)

    # EDIT HERE (report)
