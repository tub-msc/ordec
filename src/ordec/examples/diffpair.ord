from ordec.core import *
from ordec.lib.generic_mos import Nmos
from ordec.lib import Res, Vdc, Gnd, NoConn

cell DiffPair:
    viewgen symbol(self) -> Symbol:
        input inp
        input inn
        input bias
        output outp
        output outn
        inout vdd: .align=North
        inout vss

    viewgen schematic(self) -> Schematic:
        port inp
        port bias
        port outp: .align=East
        port inn: .align=West
        port outn
        net vss

        with Series(gap=4):
            port vdd
            with Parallel(gap=6):
                with Series():
                    Res rl: .$r=10k
                    Nmos m1: .g -- inp; .b -- vss; .d -- outp; .$w=10u
                with Series():
                    Res rr: .$r=10k
                    Nmos m2: .orientation=FlippedSouth; .g -- inn; .b -- vss; .d -- outn; .$w=10u
            Nmos mtail: .g -- bias; .b -- vss; .$w=20u
            port vss

cell DiffPairTb:
    viewgen schematic(self) -> Schematic:
        net inp, inn, bias, outp, outn, vdd, vss

        with Row(gap=6):
            with Col(gap=2, align='start'):
                with Row(gap=3):
                    Vdc vsupply: .$dc=5; .n -- vss; .p -- vdd
                    Vdc vbias: .$dc=1.1; .n -- vss; .p -- bias
                    Vdc vinn: .$dc=2.5; .n -- vss; .p -- inn
                    Vdc vinp: .$dc=2.5; .n -- vss; .p -- inp
                Gnd gnd: .p -- vss
            DiffPair dut: .inp -- inp; .inn -- inn; .bias -- bias; .outp -- outp; .outn -- outn; .vdd -- vdd; .vss -- vss
            with Col(gap=2):
                NoConn nc0: .a -- outn
                NoConn nc1: .a -- outp

    viewgen sim_dc(self) -> Simulation:
        .simulate().dc_sweep(self.schematic.vinp, 1.5, 3.5, 100)

    viewgen report_dc(self) -> Report:
        sim = self.sim_dc
        .markdown("# Differential pair transfer curve\n")
        .plot2d(("outp", sim.inp.voltage, sim.outp.voltage),
            ("outn", sim.inp.voltage, sim.outn.voltage),
            xlabel="Vinp (V)",
            ylabel="Vout (V)")
