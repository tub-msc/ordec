#
# Supplementary SKY130 FEOL checks for rules that the PDK's KLayout deck
# (sky130A_mr.drc) does not implement. Rule ids follow the SkyWater
# periphery rules (skywater-pdk.readthedocs.io/en/main/rules). The rule
# values arrive as -rd variables in um, taken from ordec.lib.sky130's
# tech_rules table by run_drc, so the generators and this deck share one
# source of truth.
#
# Two idioms deviate from a literal reading of the rules:
# - "one of two adjacent sides" enclosures (licon.5c, licon.7, licon.8a) use
#   the corner construction from sky130A_mr.drc's li.5 check: a contact is
#   flagged when two adjacent edges are both under-enclosed.
# - poly.7/poly.8 (directed extension of diff/poly past the gate) are
#   approximated as minimum-width checks of the diff/poly pieces adjacent to
#   a gate, which is exact for rectangular fingers.

if $input
  source($input, $top_cell)
end

report("ORDeC SKY130 supplement", $report)

if $thr
  threads($thr)
else
  threads(1)
end

deep

nwell = polygons(64, 20)
diff  = polygons(65, 20)
tap   = polygons(65, 44)
poly  = polygons(66, 20)
licon = polygons(66, 44)
npc   = polygons(95, 20)
nsdm  = polygons(93, 44)
psdm  = polygons(94, 20)

gate = poly & diff
licon_poly = licon & poly
licon_diff = licon & diff
licon_tap  = licon & tap

ndiff = diff - psdm
pdiff = diff & psdm
ptap  = tap - nsdm
ntap  = tap & nsdm

# licon
licon.space($licon_space.to_f, euclidian).output("licon.2",
  "licon.2 : min. licon spacing : #{$licon_space}um")
diff.enclosing(licon_diff, $licon_encl_diff_min.to_f, euclidian).output("licon.5a",
  "licon.5a : min. diff enclosure of licon : #{$licon_encl_diff_min}um")

le5c = diff.enclosing(licon_diff, $licon_encl_diff.to_f, projection).second_edges
le5c_corners = le5c.width(angle_limit(100.0), 1.dbu)
licon_diff.interacting(le5c_corners.polygons(1.dbu)).output("licon.5c",
  "licon.5c : min. diff enclosure of licon on one of two adjacent sides : #{$licon_encl_diff}um")

le7 = tap.enclosing(licon_tap, $licon_encl_tap.to_f, projection).second_edges
le7_corners = le7.width(angle_limit(100.0), 1.dbu)
licon_tap.interacting(le7_corners.polygons(1.dbu)).output("licon.7",
  "licon.7 : min. tap enclosure of licon on one of two adjacent sides : #{$licon_encl_tap}um")

poly.enclosing(licon_poly, $licon_encl_poly_min.to_f, euclidian).output("licon.8",
  "licon.8 : min. poly enclosure of licon : #{$licon_encl_poly_min}um")

le8a = poly.enclosing(licon_poly, $licon_encl_poly.to_f, projection).second_edges
le8a_corners = le8a.width(angle_limit(100.0), 1.dbu)
licon_poly.interacting(le8a_corners.polygons(1.dbu)).output("licon.8a",
  "licon.8a : min. poly enclosure of licon on one of two adjacent sides : #{$licon_encl_poly}um")

licon_poly.separation(psdm, $licon_psdm_space.to_f, euclidian).output("licon.9",
  "licon.9 : min. poly licon spacing to psdm : #{$licon_psdm_space}um")
(licon_diff + licon_tap).separation(gate, $licon_gate_space.to_f, euclidian).output("licon.11",
  "licon.11 : min. diff/tap licon spacing to gate : #{$licon_gate_space}um")
licon_poly.separation(diff + tap, $licon_poly_diff_space.to_f, euclidian).output("licon.14",
  "licon.14 : min. poly licon spacing to diff/tap : #{$licon_poly_diff_space}um")
npc.enclosing(licon_poly, $licon_encl_npc.to_f, euclidian).output("licon.15",
  "licon.15 : min. npc enclosure of poly licon : #{$licon_encl_npc}um")
licon_poly.not_inside(npc).output("licon.18",
  "licon.18 : poly licon must be covered by npc")

# npc
npc.separation(gate, $npc_gate_space.to_f, euclidian).output("npc.4",
  "npc.4 : min. npc spacing to gate : #{$npc_gate_space}um")

# poly resistor spacing (self/notch spacing of the marked body, catching
# meander stripes drawn too close, while the full poly.9 also covers
# unrelated poly and diff/tap)
polyres = poly & polygons(66, 13)
polyres.space($res_poly_space.to_f, euclidian).output("poly.9",
  "poly.9 : min. poly resistor spacing : #{$res_poly_space}um")

# poly/diff extensions past the gate (approximated, see header)
(diff - poly).interacting(gate).width($diff_ext_poly.to_f, euclidian).output("poly.7",
  "poly.7 : min. extension of diff beyond gate : #{$diff_ext_poly}um")
(poly - diff).interacting(gate).width($poly_endcap.to_f, euclidian).output("poly.8",
  "poly.8 : min. extension of poly beyond diff (endcap) : #{$poly_endcap}um")

# implants
nsdm.enclosing(ndiff, $implant_encl.to_f, euclidian).output("nsd.5a",
  "nsd.5a : min. nsdm enclosure of diff : #{$implant_encl}um")
ndiff.not_inside(nsdm).output("nsd.9",
  "nsd.9 : n+ diff must be covered by nsdm")
nsdm.enclosing(ntap, $implant_encl.to_f, euclidian).output("nsd.5b",
  "nsd.5b : min. nsdm enclosure of tap : #{$implant_encl}um")
ntap.not_inside(nsdm).output("nsd.9b",
  "nsd.9 : n+ tap must be covered by nsdm")
psdm.enclosing(pdiff, $implant_encl.to_f, euclidian).output("psd.5a",
  "psd.5a : min. psdm enclosure of diff : #{$implant_encl}um")
psdm.enclosing(ptap, $implant_encl.to_f, euclidian).output("psd.5b",
  "psd.5b : min. psdm enclosure of tap : #{$implant_encl}um")
ptap.not_inside(psdm).output("psd.9",
  "psd.9 : p+ tap must be covered by psdm")
nsdm.separation(pdiff + ptap, $implant_space_opposite.to_f, euclidian).output("nsd.7",
  "nsd.7 : min. nsdm spacing to opposite implant diff/tap : #{$implant_space_opposite}um")
psdm.separation(ndiff + ntap, $implant_space_opposite.to_f, euclidian).output("psd.7",
  "psd.7 : min. psdm spacing to opposite implant diff/tap : #{$implant_space_opposite}um")

# nwell
nwell.enclosing(pdiff, $nwell_encl.to_f, euclidian).output("difftap.8",
  "difftap.8 : min. nwell enclosure of p+ diff : #{$nwell_encl}um")
pdiff.not_inside(nwell).output("difftap.8a",
  "difftap.8 : p+ diff must be inside nwell")
ndiff.separation(nwell, $ndiff_nwell_space.to_f, euclidian).output("difftap.9",
  "difftap.9 : min. n+ diff spacing to nwell : #{$ndiff_nwell_space}um")
nwell.enclosing(ntap, $nwell_encl.to_f, euclidian).output("difftap.10",
  "difftap.10 : min. nwell enclosure of n+ tap : #{$nwell_encl}um")
ntap.not_inside(nwell).output("difftap.10a",
  "difftap.10 : n+ tap must be inside nwell")
ptap.separation(nwell, $ptap_nwell_space.to_f, euclidian).output("difftap.11",
  "difftap.11 : min. p+ tap spacing to nwell : #{$ptap_nwell_space}um")
