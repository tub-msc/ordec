from ordec.core import *
from .inverter import Inv
from .mux2 import Mux2

cell D_latch:
    viewgen symbol -> Symbol:
        input D
        input LE
        input vdd: .align = North
        input vss: .align = South
        output Q

    viewgen schematic -> Schematic:
        port D: .pos = (1, 13)
        port LE: .pos = (1, 14)
        port vdd: .pos = (1, 18); .align = East
        port vss: .pos = (1, 7); .align = East
        port Q: .pos = (24, 12)

        net mux_out

        Mux2 m1:
            .vdd -- vdd
            .vss -- vss
            .a -- Q
            .b -- D
            .s -- LE
            .y -- mux_out
            .pos = (5, 10)

        Inv i1:
            .vdd -- vdd
            .vss -- vss
            .a -- mux_out
            .y -- Q
            .pos = (18, 10)
