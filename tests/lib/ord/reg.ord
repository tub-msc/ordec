from ordec.core import *
from ..schematics import DFF

cell MultibitReg_Arrays:
    bits = Parameter(int)
    viewgen symbol(self) -> Symbol:
        input vdd: .orient=North
        input vss: .orient=South
        path d
        path q
        for i in range(self.bits):
            input d[i]
            output q[i]
        input clk

    viewgen schematic(self) -> Schematic:
        port vss: .pos=(1,0); .orient=East
        port vdd: .pos=(1,1); .orient=East
        port clk: .pos=(1,2)
        path d
        path q
        path I
        for i in range(self.bits):
            port d[i]: .pos=(4, 5 + 8 * i)
            port q[i]: .pos=(14, 5 + 8 * i)
            DFF I[i]:
                .vss -- vss
                .vdd -- vdd
                .clk -- clk
                .d -- d[i]
                .q -- q[i]
            I[i].pos = (6, 3 + 8 * i)
