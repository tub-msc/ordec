from ordec.core import *
from ordec.lib.generic_mos import Nmos,Pmos

cell Inv:
    viewgen symbol -> Symbol:
        inout vdd: .align=North
        inout vss
        input a
        output y

    viewgen schematic -> Schematic:
        port vdd: .align=North
        port vss: .align=South
        port y
        port a

        Nmos pd:
            .s -- vss
            .b -- vss
            .d -- y
        Pmos pu:
            .s -- vdd
            .b -- vdd
            .d -- y
            .$l = 400n
        pu.$w = 200n

        ! vss.pos == (2, 1)
        ! vdd.pos == vss.pos + (0, 12)
        ! y.pos.y == pd.d.pos.y + 1
        ! y.pos.x == pd.b.pos.x + 2
        ! a.pos == vss.pos + (0, 6)
        ! pd.pos == vss.pos + (2, 1)
        ! pd.outline.north + (0, 2) == pu.outline.south

        for instance in pu, pd:
            instance.g -- a
