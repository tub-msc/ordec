from ordec.core import *
from ordec.lib import Res
from ordec.lib.ihp130 import SG13G2
from ordec.core.wire import ExportTable

def test_symbol_dot():
    root=Symbol()
    with root.ctx():
        # We can access our current context root via '.':
        assert . == __ord_context__.root() == root
        .outline = (0,1,2,3)
        assert .outline == (0,1,2,3)
    assert root.outline == Rect4R(0,1,2,3)

def test_symbol_pin_creation():
    root = Symbol()
    with root.ctx():
        sym = .

        # We can create a Pin using the special input/output/inout keywords...
        # ...either bodyless (no colon and subsequent body):
        input a
        # ...or with body (colon and subsequent body):
        output b:
            .pos = (5,5)
            assert .parent == sym

        # Alternatively, we can create a Pin using 'Pin', which is the Node subclass directly from the schema...
        # ...again either bodyless:
        Pin c
        # ...or with body:
        Pin d:
            .pintype = PinType.Inout
            .align = R180
            assert .parent == sym

    assert isinstance(root.a, Pin)
    assert root.a.pintype == PinType.In
    assert root.a.pos is None
    assert isinstance(sym.b, Pin)
    assert root.b.pintype == PinType.Out
    assert root.b.pos == Vec2R(5,5)
    assert isinstance(sym.c, Pin)
    assert root.c.pos is None
    assert isinstance(sym.d, Pin)
    assert root.d.pintype == PinType.Inout
    assert root.d.align == D4.R180

def test_nested_contexts():
    root1 = Symbol()
    root2 = Symbol()
    with root1.ctx():
        input a
        assert .a == a
        with root2.ctx():
            output a
            input c
        assert .a != a
        output c

    assert root1.a.pintype == PinType.In
    assert root1.c.pintype == PinType.Out

    assert root2.a.pintype == PinType.Out
    assert root2.c.pintype == PinType.In

    # Expect our local variables to be a bit messed up now:
    assert a == root2.a
    assert c == root1.c


def test_multi_name_bodyless_node_stmt():
    root = Symbol()
    with root.ctx():
        # Multiple pins with a keyword:
        input x1, x2, x3
        assert isinstance(root.x1, Pin)
        assert isinstance(root.x2, Pin)
        assert isinstance(root.x3, Pin)
        assert root.x1.pintype == PinType.In
        assert root.x2.pintype == PinType.In
        assert root.x3.pintype == PinType.In

        # Multiple pins with a Node subclass:
        Pin p1, p2, p3

    assert isinstance(root.p1, Pin)
    assert isinstance(root.p2, Pin)
    assert isinstance(root.p3, Pin)

def test_scheminstance_creation():
    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        # Bodyless...
        # ...using a Cell subclass (unresolved: symbol resolved when the
        # viewgen completes):
        Res a
        assert isinstance(a, SchemInstance)
        assert a.symbol is None
        a.$r = '1k'
        # ...or using a Cell subclass instance (symbol set immediately):
        Res('1k') b
        assert isinstance(b, SchemInstance)
        assert b.symbol is not None

        # With body...
        # ...using a Cell subclass:
        Res c:
            .$r = '1k'
            .pos=(1,2)
        # ...or using a Cell subclass instance:
        Res('1k') d:
            .pos=(1,2)

        assert c.pos == d.pos == Vec2R(1,2)

    sch()

    # Viewgen completion resolved all unresolved instances:
    assert root.a.symbol == root.c.symbol == Res(r='1k').symbol

def test_mixed_unresolved_resolved_instances():
    """A schematic with instances from a Cell instance (symbol set
    immediately) and from a Cell class (unresolved symbol, params set via
    body), wired together. All unresolved instances are resolved when the
    viewgen completes."""
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid

        # Cell instance -> symbol set immediately
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        # Cell class -> unresolved instance (params set via body)
        Res r1: .$r = '1k'; .p -- mid; .n -- vss; .pos = (5, 6)
        # Another Cell instance
        Gnd() gnd: .p -- vss; .pos = (0, 0)

        # Before viewgen completion: v1 and gnd are resolved, r1 is unresolved
        assert v1.symbol is not None
        assert gnd.symbol is not None
        assert r1.symbol is None

        # v1 already has SchemInstanceConn (direct wiring)
        v1_conns = list(root.all(SchemInstanceConn.ref_idx.query(v1)))
        assert len(v1_conns) == 2

        # r1's wiring is deferred in the view builder, not in the graph
        r1_conns = list(root.all(SchemInstanceConn.ref_idx.query(r1)))
        assert len(r1_conns) == 0

    sch()

    # After viewgen completion: all instances are resolved
    all_instances = list(root.all(SchemInstance))
    assert len(all_instances) == 3
    assert all(inst.symbol is not None for inst in all_instances)
    assert root.r1.symbol == Res(r='1k').symbol

    # All connections are now SchemInstanceConn
    all_conns = list(root.all(SchemInstanceConn))
    assert len(all_conns) == 5  # v1: 2, r1: 2, gnd: 1

def test_wire_op():
    # The -- pseudo-operator is commutative: net -- pin and pin -- net should produce the same result.
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid

        # pin -- net (normal order)
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        # net -- pin (reversed order)
        Res r1: .$r = '1k'; mid -- .p; vss -- .n; .pos = (5, 6)
        # Also reversed for a Cell instance
        Gnd() gnd: vss -- .p; .pos = (0, 0)

        # All connections should be created regardless of operand order
        v1_conns = list(root.all(SchemInstanceConn.ref_idx.query(v1)))
        assert len(v1_conns) == 2

        # r1's connections are deferred until resolution
        r1_conns = list(root.all(SchemInstanceConn.ref_idx.query(r1)))
        assert len(r1_conns) == 0

        gnd_conns = list(root.all(SchemInstanceConn.ref_idx.query(gnd)))
        assert len(gnd_conns) == 1

    sch()

    # After viewgen completion: all connections are SchemInstanceConn
    all_conns = list(root.all(SchemInstanceConn))
    assert len(all_conns) == 5

def test_instance_param_last_wins():
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        Res r1: .$r = '1k'; .p -- mid; .n -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

        # While the parameters are open, assignments overwrite (last wins):
        r1.$r = '2k'

    sch()

    assert root.r1.symbol == Res(r='2k').symbol

def test_instance_param_set_after_resolution():
    import pytest
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        Res r1: .$r = '1k'; .p -- mid; .n -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

        # A geometry read forces resolution; parameters can no longer be set:
        outline_uy = r1.outline.uy
        with pytest.raises(TypeError):
            r1.$r = '2k'

    sch()

    assert root.r1.symbol == Res(r='1k').symbol

def test_instance_param_on_resolved_cell():
    import pytest
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        # Cell instance form: parameters are fixed at instantiation.
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        Res('1k') r1: .p -- mid; .n -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

        with pytest.raises(TypeError):
            r1.$r = '2k'

    sch()

def test_bad_deferred_conn_path():
    import pytest
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        # zzz is not a pin of Res; resolution at viewgen completion fails.
        Res r1: .$r = '1k'; .p -- mid; .zzz -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

    with pytest.raises(QueryException, match="'zzz' not found"):
        sch()

def test_bad_deferred_conn_path_on_access():
    import pytest
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        Res r1: .$r = '1k'; .p -- mid; .zzz -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

        # Forced resolution fails on the bad path...
        with pytest.raises(QueryException, match="'zzz' not found"):
            r1.outline.uy
        # ...and leaves the instance untouched:
        assert r1.symbol is None
        assert len(list(root.all(SchemInstanceConn.ref_idx.query(r1)))) == 0

    # Viewgen completion retries the resolution and must fail with the same
    # clean error as the first attempt: an aborted resolution leaves the
    # instance untouched, so no conns from the first attempt survive to
    # collide on retry.
    with pytest.raises(QueryException, match="'zzz' not found"):
        sch()

def test_duplicate_deferred_conn():
    import pytest
    from ordec.schematic import SchematicError
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        # r1.p is deferred-wired twice; resolution rejects this before
        # touching the instance. (On a resolved instance, the second
        # wire op raises a UniqueViolation directly.)
        Res r1: .$r = '1k'; .p -- mid; .p -- vss; .n -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

    with pytest.raises(SchematicError, match="connected more than once"):
        sch()

def test_instance_param_missing():
    import pytest
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        # r1's mandatory parameter r is never set; resolution at viewgen
        # completion fails.
        Res r1: .p -- mid; .n -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

    with pytest.raises(ParameterError, match="'r' is missing") as exc_info:
        sch()
    note, = exc_info.value.__notes__
    assert "instance r1" in note
    assert "test_ord_runtime" in note  # src_loc of the `Res r1` statement

def test_instance_param_missing_on_access():
    import pytest
    from ordec.lib import Vdc, Gnd

    root = Schematic()

    viewgen sch() -> Schematic:
        . = root
        net vss, mid
        Vdc('1') v1: .p -- mid; .n -- vss; .pos = (0, 6)
        Res r1: .p -- mid; .n -- vss; .pos = (5, 6)
        Gnd() gnd: .p -- vss; .pos = (0, 0)

        # Forced resolution fails while r is missing...
        with pytest.raises(ParameterError, match="'r' is missing"):
            r1.outline.uy
        # ...but the failed attempt leaves the instance unresolved: the
        # parameter can still be supplied.
        r1.$r = '1k'

    sch()

    assert root.r1.symbol == Res(r='1k').symbol

def test_viewgen_return_target_alias():
    ViewgenAlias = Symbol

    cell AliasViewgenReturnCell:
        viewgen symbol(self) -> ViewgenAlias:
            input alias_pin

    view = AliasViewgenReturnCell().symbol
    assert isinstance(view.alias_pin, Pin)

def test_viewgen_return_target_expression_runtime():
    viewgen_target_calls = []

    def choose_view_root():
        viewgen_target_calls.append("called")
        return Symbol

    cell DynamicViewgenReturnCell:
        viewgen symbol(self) -> choose_view_root():
            input dynamic_pin

    # choose_view_root() should be called at time of class (cell) creation,
    # so viewgen_target_calls should be populated now:
    assert viewgen_target_calls == ["called"]
    cell = DynamicViewgenReturnCell()
    assert viewgen_target_calls == ["called"]
    view = cell.symbol
    assert viewgen_target_calls == ["called"]
    assert isinstance(view.dynamic_pin, Pin)

def test_viewgen_return_target_conditional_expression():
    cell ConditionalViewgenReturnCell:
        viewgen symbol(self) -> Symbol if True else Schematic:
            input conditional_pin

    view = ConditionalViewgenReturnCell().symbol
    assert isinstance(view.conditional_pin, Pin)

cell LayoutTestCell:
    viewgen layout(self) -> Layout:
        .ref_layers = SG13G2().layers
        layers = .ref_layers
        LayoutRect r:
            .layer = layers.Metal1
        ! .r.width == 100
        ! .r.height == 100
        ! .r.lx == 0
        ! .r.ly == 0

cell ReportTestCell:
    viewgen report(self) -> Report:
        .markdown("hello")

def test_empty_schematic():
    # A cell with an empty schematic and no symbol viewgen must build and
    # render without raising.
    cell EmptySchematic:
        viewgen schematic(self) -> Schematic:
            pass

    sch = EmptySchematic().schematic
    assert sch.symbol is None
    sch.webdata(ExportTable())

def test_report_viewgen_uses_schema_runtime():
    view = ReportTestCell().report
    assert isinstance(view, Report)
    assert "hello" in view.webdata(ExportTable())[1]["elements"][0]["html"]

def test_minimal_layout():
    c = LayoutTestCell()
    layout = c.layout
    layers = SG13G2().layers
    assert layout.ref_layers == layers
    assert layout.r.layer == layers.Metal1

def test_layout_instance_shorthand():
    root = Layout()
    tc = LayoutTestCell()
    with root.ctx():
        tc a
        assert isinstance(a, LayoutInstance)
        assert a.ref == tc.layout

        tc b: .orientation = MX
        assert isinstance(b, LayoutInstance)
        assert b.ref == tc.layout
        assert b.orientation == D4.MX

cell ParamLayoutCell:
    w = Parameter(int)
    viewgen layout(self) -> Layout:
        .ref_layers = SG13G2().layers
        layers = .ref_layers
        LayoutRect r:
            .layer = layers.Metal1
        ! .r.width == self.w
        ! .r.height == 100
        ! .r.lx == 0
        ! .r.ly == 0

def test_layout_instance_unresolved():
    root = Layout()

    viewgen lay() -> Layout:
        . = root
        .ref_layers = SG13G2().layers
        # Cell subclass -> unresolved instance, parametrized via .$ like in
        # schematics; resolved when the viewgen completes.
        ParamLayoutCell a:
            .$w = 120
            ! .pos == (0, 0)
        assert isinstance(a, LayoutInstance)
        assert a.ref is None

    lay()

    assert root.a.ref == ParamLayoutCell(w=120).layout
    assert root.a.r.width == 120

def test_layout_instance_resolved_on_access():
    import pytest

    root = Layout()

    viewgen lay() -> Layout:
        . = root
        .ref_layers = SG13G2().layers
        ParamLayoutCell a:
            .$w = 120
            ! .pos == (0, 0)

        # Any access through the instance requires the resolved layout:
        # it resolves the instance.
        a.r
        assert a.ref is not None
        with pytest.raises(TypeError):
            a.$w = 240

    lay()

    assert root.a.ref == ParamLayoutCell(w=120).layout

def test_layout_instance_param_missing():
    import pytest

    root = Layout()

    viewgen lay() -> Layout:
        . = root
        .ref_layers = SG13G2().layers
        # a's mandatory parameter w is never set; resolution at viewgen
        # completion fails.
        ParamLayoutCell a:
            ! .pos == (0, 0)

    with pytest.raises(ParameterError, match="'w' is missing") as exc_info:
        lay()
    note, = exc_info.value.__notes__
    assert "instance a" in note
    assert "test_ord_runtime" in note  # src_loc of the `ParamLayoutCell a` statement

def test_layout_instance_param_missing_on_access():
    import pytest

    root = Layout()

    viewgen lay() -> Layout:
        . = root
        .ref_layers = SG13G2().layers
        ParamLayoutCell a:
            ! .pos == (0, 0)

        # Forced resolution fails while w is missing...
        with pytest.raises(ParameterError, match="'w' is missing"):
            a.r
        # ...but the failed attempt leaves the instance unresolved: the
        # parameter can still be supplied.
        a.$w = 120

    lay()

    assert root.a.ref == ParamLayoutCell(w=120).layout

def test_node_as_context_manager():
    root = Symbol()
    with root.ctx():
        input a
        assert .a == a
        assert .a.pintype == PinType.In
    assert root.a.pintype == PinType.In


def add_pin_x():
    Pin x

def add_pin_y():
    Pin y

def count_pins():
    return len(list(.all(Pin)))

def test_nodecontext_across_calls():
    """Checks that node context works across function calls"""
    with Symbol().ctx():
        add_pin_x()
        add_pin_y()
        assert count_pins() == 2

def test_anonymous_node_stmt():
    """Anonymous node statements create nodes without NPath entries."""
    root = Symbol()
    with root.ctx():
        # Anonymous bodyless
        anonymous Pin a
        assert isinstance(a, Pin)

        # Anonymous with body
        anonymous Pin b:
            .pintype = PinType.Out

        assert isinstance(b, Pin)
        assert b.pintype == PinType.Out

        # Regular pin for comparison
        Pin c

        # c has an NPath, a and b don't
        assert root.c == c
        # a and b should not be accessible via path
        import pytest
        with pytest.raises(AttributeError):
            root.a
        with pytest.raises(AttributeError):
            root.b

def test_anonymous_in_loop():
    """Anonymous nodes in loops don't clash on NPath names."""
    root = Symbol()
    pins = []
    with root.ctx():
        for i in range(3):
            anonymous Pin p
            pins.append(p)
    assert len(pins) == 3
    # All are distinct nodes
    assert len(set(id(p) for p in pins)) == 3

def test_anonymous_multi_target():
    """Anonymous node statement with multiple targets."""
    root = Symbol()
    with root.ctx():
        anonymous Pin x, y, z
        assert isinstance(x, Pin)
        assert isinstance(y, Pin)
        assert isinstance(z, Pin)

def test_anonymous_as_identifier():
    """'anonymous' can still be used as a variable name."""
    anonymous = 42
    assert anonymous == 42

def test_toplevel_viewgen_report():
    # Outside of a cell, a viewgen is a plain cached function (function
    # form, like a module-level @viewgen).
    viewgen toplevel_report() -> Report:
        """A report viewgen outside of a cell."""
        .markdown("toplevel hello")

    view = toplevel_report()
    assert isinstance(view, Report)
    assert "toplevel hello" in view.webdata(ExportTable())[1]["elements"][0]["html"]
    # Cached: repeated calls return the identical view.
    assert toplevel_report() is view
    assert toplevel_report.__doc__ == "A report viewgen outside of a cell."

def test_toplevel_viewgen_symbol():
    viewgen toplevel_symbol() -> Symbol:
        input a

    sym = toplevel_symbol()
    assert isinstance(sym.a, Pin)
    # No cell is associated with a cell-less view.
    assert sym.cell is None

def test_viewgen_decorated_auto_refresh():
    # `@viewgen(auto_refresh=False)` on top of a viewgen reconfigures it
    # (re-decoration takes over the wrapped function; see the drc/lvs
    # viewgens in vco_pseudodiff.ord).
    cell SlowViewCell:
        @viewgen(auto_refresh=False)
        viewgen symbol(self) -> Symbol:
            input a

    assert isinstance(SlowViewCell().symbol.a, Pin)
    assert SlowViewCell.symbol.auto_refresh == False

def test_viewgen_early_return():
    # A bare `return` exits the body early. Postprocessing still runs and
    # the view is the context root regardless.
    cell EarlyReturnCell:
        viewgen symbol(self) -> Symbol:
            input a
            if True:
                return
            input b

    sym = EarlyReturnCell().symbol
    assert isinstance(sym.a, Pin)
    assert len(list(sym.all(Pin))) == 1

def test_viewgen_return_value_rejected():
    # Returning a value from a viewgen body is a misuse (the view is
    # always the context root) and must fail loudly, like a value-
    # returning __init__.
    import pytest

    cell BadReturnCell:
        viewgen symbol(self) -> Symbol:
            input a
            return 42

    with pytest.raises(TypeError, match="instead of None"):
        BadReturnCell().symbol

def test_conditional_viewgen_in_cell():
    # Conditional method definition, as in a Python class body: a viewgen
    # nested in a compound statement of the cell suite binds in the cell
    # namespace and is an ordinary view method.
    for flavor in ("a", "b"):
        cell CondCell:
            if flavor == "a":
                viewgen symbol(self) -> Symbol:
                    input a
            else:
                viewgen symbol(self) -> Symbol:
                    input b

        sym = CondCell().symbol
        assert isinstance(getattr(sym, flavor), Pin)

def test_toplevel_viewgen_schematic_port_rejected():
    # A cell-less schematic has no symbol, so declaring a port must fail
    # with a clear error instead of an opaque AttributeError.
    import pytest

    viewgen bad_sch() -> Schematic:
        port vdd

    with pytest.raises(TypeError, match="no symbol"):
        bad_sch()

def test_viewgen_in_function():
    # A viewgen in a nested scope is a function-form viewgen; a closure
    # can parametrize it (factory pattern).
    def make_report_view(text):
        viewgen inner() -> Report:
            .markdown(text)
        return inner

    view = make_report_view("factory hello")()
    assert "factory hello" in view.webdata(ExportTable())[1]["elements"][0]["html"]

def test_toplevel_viewgen_sim_rejected():
    # Simulation views require a cell's schematic; module-level sim
    # viewgens must fail with a clear error.
    import pytest

    viewgen toplevel_sim() -> SimHierarchy:
        pass

    with pytest.raises(TypeError, match="outside of a cell"):
        toplevel_sim()

def test_viewgen_double_root_assignment():
    # `. =` can establish the view root only once.
    import pytest

    viewgen bad() -> Schematic:
        . = Schematic()
        . = Schematic()

    with pytest.raises(TypeError, match="already established"):
        bad()

def test_viewgen_root_assignment_after_node_op():
    # A node operation materializes the root from the annotation; a later
    # `. =` must fail instead of silently replacing it.
    import pytest

    viewgen bad() -> Symbol:
        input a
        . = Symbol()

    with pytest.raises(TypeError, match="already established"):
        bad()

def test_nested_viewgen_isolation():
    # A viewgen evaluated while another viewgen body is running must not
    # leak its node operations into the outer viewgen's context — even
    # when it runs before the outer body's first node op, while the outer
    # context is not yet established.
    viewgen inner() -> Symbol:
        input b

    cell OuterCell:
        viewgen symbol(self) -> Symbol:
            inner_sym = inner()
            assert isinstance(inner_sym.b, Pin)
            input a

    sym = OuterCell().symbol
    assert isinstance(sym.a, Pin)
    assert len(list(sym.all(Pin))) == 1
    assert len(list(inner().all(Pin))) == 1

def test_noctx_on_viewgen_flips_protocol():
    # Re-decoration takes over the wrapped function, and the outer
    # decorator picks the protocol: @viewgen_noctx stacked on a
    # context-style body installs no context, so the body's first node op
    # fails loudly instead of leaking into an outer context.
    import pytest

    @viewgen_noctx
    viewgen bad() -> Symbol:
        input a

    with pytest.raises(TypeError, match="use @viewgen"):
        bad()

def test_viewgen_shape_rejected_at_exec():
    # Extra parameters beyond the receiver fail at decoration time, i.e.
    # when the compiled module executes.
    import pytest
    from ordec.language import compile_ord

    for src in (
        "cell Foo:\n    viewgen symbol(a, b):\n        pass\n",
        "cell Foo:\n    viewgen symbol(a=1):\n        pass\n",
    ):
        g = {}
        code = compile_ord(src, g)
        with pytest.raises(TypeError, match="Cell Parameters"):
            exec(code, g)
